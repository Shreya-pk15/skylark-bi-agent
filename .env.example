# Groq Model (defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
# Groq API key — FREE, no credit card needed (get one at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# monday.com personal API token (Admin -> Developers -> My Access Tokens)
# Needs "boards:read" for the agent; "boards:write" too if you'll run
# scripts/setup_monday_boards.py to provision the boards.
MONDAY_API_TOKEN=your_monday_api_token_here

# Board IDs — printed by scripts/setup_monday_boards.py after it creates
# the boards, or copy from the board URL: monday.com/boards/<THIS NUMBER>
MONDAY_WORK_ORDERS_BOARD_ID=your_work_orders_board_id_here
MONDAY_DEALS_BOARD_ID=your_deals_board_id_here


